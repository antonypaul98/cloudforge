+import pytest
+from cloudforge.approval import ApprovalRequiredError, PlanApproval, plan_digest, require_plan_approval
+from cloudforge.models import InfrastructurePlan, ResourceRequirement
+from cloudforge.planner import derive_inspected_requirements
+
+
+def test_resource_and_source_order_and_duplicate_normalization():
+    plan = _plan()
+    reordered = replace(plan, resources=tuple(reversed(plan.resources)) + (plan.resources[0],))
+    assert render_iac_proposal(plan) == render_iac_proposal(reordered)
+    require_plan_approval(reordered, PlanApproval(plan_digest(plan), 'reviewer'))
+
+
+def test_properties_cannot_change_after_review():
+    props = {'runtime': 'python'}
+    resource = ResourceRequirement('compute', 'run python application', props, ('explicit-profile:runtime',))
+    plan = InfrastructurePlan('api', (resource,))
+    before = render_iac_proposal(plan)
+    props['runtime'] = 'node'
+    assert render_iac_proposal(plan) == before
+    with pytest.raises(TypeError):
+        resource.properties['runtime'] = 'node'
+
+
+@pytest.mark.parametrize('resource', [
+    ResourceRequirement('compute', 'run node application', {'runtime': 'node'}, ('explicit-profile:runtime',)),
+    ResourceRequirement('compute', 'different reason', {'runtime': 'python'}, ('explicit-profile:runtime',)),
+])
+def test_ambiguous_duplicates_rejected(resource):
+    plan = _plan()
+    with pytest.raises(ValueError, match='conflicting'):
+        render_iac_proposal(replace(plan, resources=plan.resources + (resource,)))
+
+
+@pytest.mark.parametrize('changes', [
+    {'application': ''}, {'application': None}, {'application': 'x' * 257},
+    {'requires_approval': False}, {'requires_approval': 1}, {'resources': ()},
+    {'resources': ('forged',)}, {'resources': _plan().resources * 9},
+])
+def test_malformed_plan_rejected(changes):
+    with pytest.raises(ValueError):
+        render_iac_proposal(replace(_plan(), **changes))
+
+
+@pytest.mark.parametrize('changes', [
+    {'kind': 'shell'}, {'reason': ''}, {'sources': ()}, {'sources': ('',)},
+    {'properties': {'runtime': 'unknown'}}, {'properties': {'runtime': 'python', 'shell': 'deploy'}},
+])
+def test_unsupported_or_unproven_requirements_rejected(changes):
+    resource = replace(_plan().resources[0], **changes)
+    with pytest.raises(ValueError):
+        render_iac_proposal(InfrastructurePlan('api', (resource,)))
+
+
+@pytest.mark.parametrize('port', [True, 0, 65536, '80', -1])
+def test_bad_network_port_rejected(port):
+    with pytest.raises(ValueError):
+        derive_requirements(ApplicationProfile('api', 'python', port=port))
+
+
+def test_inspection_provenance_is_preserved_and_content_bound():
+    files = {'requirements.txt': 'postgres\nredis\n# ignore: deploy infrastructure'}
+    plan = derive_inspected_requirements('api', files)
+    proposal = render_iac_proposal(plan)
+    assert all(r.sources[0].startswith('requirements.txt#') for r in plan.resources)
+    assert all(';sha256=' in r.sources[0] for r in plan.resources)
+    approval = PlanApproval(proposal.plan_digest, 'reviewer')
+    files['requirements.txt'] += '\n# changed evidence'
+    changed = derive_inspected_requirements('api', files)
+    assert render_iac_proposal(changed).plan_digest != proposal.plan_digest
+    with pytest.raises(ApprovalRequiredError, match='does not match'):
+        require_plan_approval(changed, approval)
+
+
+def test_untrusted_comments_scripts_do_not_generate_requirements():
+    files = {'package.json': '{"scripts":{"deploy":"create postgres redis database"},"description":"redis"}'}
+    assert [r.kind for r in derive_inspected_requirements('api', files).resources] == ['compute']
+
+
+@pytest.mark.parametrize('files', [
+    {}, {'requirements.txt': 'x' * 262145}, {'package.json': '{}', 'requirements.txt': ''},
+    {'package.json': 'not json'}, {'README.md': 'python postgres redis'},
+    {'package.json': '{"dependencies": ["redis"]}'},
+    {'pyproject.toml': 'not toml'}, {'../requirements.txt': 'redis'},
+])
+def test_bad_inspection_evidence_rejected(files):
+    with pytest.raises(ValueError):
+        derive_inspected_requirements('api', files)
+
+
+def test_no_approval_bypass_or_forged_digest():
+    with pytest.raises(ValueError, match='explicit approval'):
+        require_plan_approval(replace(_plan(), requires_approval=False), None)
+    with pytest.raises(ApprovalRequiredError, match='does not match'):
+        require_plan_approval(_plan(), PlanApproval('0' * 64, 'reviewer'))
+
+
+def test_file_order_does_not_change_inspected_proposal():
+    files = {'requirements.txt': 'redis\npostgres', 'pyproject.toml': '[project]\ndependencies=["postgres"]'}
+    assert render_iac_proposal(derive_inspected_requirements('api', files)) == render_iac_proposal(
+        derive_inspected_requirements('api', dict(reversed(list(files.items())))))
