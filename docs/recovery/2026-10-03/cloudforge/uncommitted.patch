+def derive_inspected_requirements(name: str, files: dict[str, str]) -> InfrastructurePlan:
+    """Reinspect bounded source text, retaining paths and source-content hashes.
+
+    Accept sources rather than a caller-forgeable InspectionResult. File hashes
+    bind provenance to supplied text, not to an asserted trusted repository.
+    """
+    import hashlib
+    from pathlib import PurePosixPath
+    if not isinstance(files, dict) or not 1 <= len(files) <= 32:
+        raise ValueError("inspection requires 1..32 source files")
+    if any(type(p) is not str or len(p) > 256 or type(c) is not str or len(c.encode('utf-8')) > 262144 for p, c in files.items()):
+        raise ValueError("malformed or oversized inspection source")
+    normalized = {PurePosixPath(p).as_posix(): c for p, c in files.items()}
+    if 'package.json' in normalized and {'pyproject.toml', 'requirements.txt'} & normalized.keys():
+        raise ValueError("ambiguous runtime manifests")
+    result = inspect_application(name, files)
+    if result.warnings:
+        raise ValueError("inspection evidence is incomplete: " + '; '.join(result.warnings))
+    plan = derive_requirements(result.profile)
+    resources = []
+    for resource in plan.resources:
+        fact = 'runtime' if resource.kind == 'compute' else 'dependency'
+        value = resource.properties.get('runtime', resource.properties.get('engine'))
+        sources = tuple(sorted({f'{e.path}#{e.fact}={e.value};sha256={hashlib.sha256(normalized[e.path].encode()).hexdigest()}'
+                                for e in result.evidence if e.fact == fact and e.value == value}))
+        resources.append(replace(resource, sources=sources))
+    plan = replace(plan, resources=tuple(resources))
+    plan_payload(plan)
+    return plan
